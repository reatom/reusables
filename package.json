{
  "name": "@reatom/reusables",
  "version": "1.0.0",
  "description": "A collection of reusable reatom extensions, utilities and integrations",
  "private": true,
  "scripts": {
    "dev": "astro dev --config .config/astro.config.mjs",
    "build": "pnpm jsrepo:build && astro build --config .config/astro.config.mjs",
    "preview": "astro preview --config .config/astro.config.mjs",
    "test": "vitest run --config .config/vitest.config.ts",
    "test:browser": "vitest run --config .config/vitest.config.ts --project browser",
    "format": "prettier --ignore-path .config/prettierignore --write .",
    "format:check": "prettier --ignore-path .config/prettierignore --check .",
    "jsrepo:build": "jsrepo build",
    "prepare": "node .config/scripts/prepare.mjs && husky",
    "typecheck": "astro check && pnpm --filter reatom-reusables-promo typecheck",
    "check": "pnpm lint:workflows && pnpm format:check && pnpm typecheck && pnpm test && pnpm build && pnpm test:site",
    "test:node": "vitest run --config .config/vitest.config.ts --project node",
    "test:browser:ui": "vitest --config .config/vitest.config.ts --project browser --browser.headless=false",
    "test:watch": "vitest --config .config/vitest.config.ts",
    "video:dev": "pnpm --filter reatom-reusables-promo dev",
    "video:build": "pnpm --filter reatom-reusables-promo build",
    "test:site": "node .config/scripts/check-site.mjs",
    "lint:workflows": "mise exec -- jactionlint --strict-exit"
  },
  "keywords": [
    "jsrepo",
    "reatom",
    "reactive",
    "state management",
    "extensions"
  ],
  "author": "Aleksei Gurianov <gurianov@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@reatom/core": "^1001.3.0",
    "@reatom/react": "^1001.0.1",
    "@tweakpane/core": "^2.0.5",
    "@tweakpane/plugin-essentials": "^0.2.1",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.0",
    "astro": "^7.4.7",
    "husky": "^9.1.7",
    "jsrepo": "^3.8.3",
    "lint-staged": "^17.6.0",
    "marked": "^18.1.3",
    "mermaid": "^12.3.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-jsdoc": "^1.8.1",
    "react": "^19.3.1",
    "shiki": "^4.6.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx,mjs,cjs,mts,json,md,mdx,css,scss,yaml,yml}": "prettier --ignore-path .config/prettierignore --write",
    "*.astro": "prettier --ignore-path .config/prettierignore --write"
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.18.0 <13"
  }
}
