{
  "name": "reatom-reusables-promo",
  "version": "1.0.0",
  "description": "Remotion promo video for Reatom reusables registry",
  "scripts": {
    "dev": "remotion studio --config .config/remotion.config.ts",
    "start": "remotion studio --config .config/remotion.config.ts",
    "build": "remotion render src/index.ts ReatomPromo ../.var/remotion/promo.mp4 --config .config/remotion.config.ts",
    "upgrade": "remotion upgrade",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.541",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.541"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true
}
