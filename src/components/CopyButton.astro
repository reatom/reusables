---
interface Props {
  text: string
  label?: string
}

const { text, label = 'Copy' } = Astro.props
---

<button
  class="copy-btn"
  data-copy={text}
  type="button"
  aria-label={`Copy ${text}`}
>
  <span class="copy-label">{label}</span>
  <span class="copy-check" aria-hidden="true">
    Copied!
  </span>
  <span class="copy-status" role="status" aria-live="polite"></span>
</button>

<style>
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-gray-5);
    color: var(--color-gray-2);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }

  .copy-btn:hover {
    background: var(--color-bg-surface-hover);
    color: var(--color-white);
  }

  .copy-check {
    display: none;
    color: #6bcf9a;
  }

  .copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .copy-btn.copied .copy-label {
    display: none;
  }

  .copy-btn.copied .copy-check {
    display: inline;
  }
</style>

<script>
  function initCopyButtons() {
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
      if (btn.hasAttribute('data-copy-bound')) return
      btn.setAttribute('data-copy-bound', 'true')
      btn.addEventListener('click', (e) => {
        e.stopPropagation()
        const text = btn.dataset.copy
        if (!text) return
        const status = btn.querySelector('.copy-status')
        if (!navigator.clipboard || !navigator.clipboard.writeText) {
          if (status)
            status.textContent =
              'Clipboard unavailable. Select and copy the command.'
          return
        }
        navigator.clipboard
          .writeText(text)
          .then(() => {
            if (status) status.textContent = 'Copied to clipboard'
            btn.classList.add('copied')
            setTimeout(() => btn.classList.remove('copied'), 1500)
          })
          .catch(() => {
            if (status)
              status.textContent = 'Copy failed. Select and copy the command.'
          })
      })
    })
  }
  initCopyButtons()
  document.addEventListener('astro:after-swap', initCopyButtons)
</script>
