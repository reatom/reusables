---
import type { Reusable } from '../lib/registry'
import TypeBadge from './TypeBadge.astro'

interface Props {
  reusable: Reusable
}

const { reusable } = Astro.props

function getDescription(doc: string | null): string {
  if (!doc) return ''
  const lines = doc.split('\n')
  for (const line of lines) {
    const trimmed = line.trim()
    if (trimmed && !trimmed.startsWith('#')) {
      return trimmed
        .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
        .replace(/`([^`]+)`/g, '$1')
    }
  }
  return ''
}

const description = getDescription(reusable.doc)
---

<a
  href={`${import.meta.env.BASE_URL}${reusable.name}/`}
  class="reusable-card"
  data-reusable
  data-type={reusable.type}
  data-search={`${reusable.name} ${description}`.toLowerCase()}
>
  <div class="card-header">
    <span class="card-name">{reusable.name}</span>
    <TypeBadge type={reusable.type} />
  </div>
  {description && <p class="card-description">{description}</p>}
  <span class="card-action">
    View source & docs <span aria-hidden="true">↗</span>
  </span>
</a>

<style>
  .reusable-card {
    display: flex;
    flex-direction: column;
    background: linear-gradient(
      135deg,
      var(--color-bg-surface),
      var(--color-bg)
    );
    border: 1px solid var(--color-gray-5);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    transition:
      border-color 0.15s,
      background 0.15s;
    color: inherit;
    min-width: 0;
  }

  .reusable-card:hover {
    border-color: var(--color-accent);
    background: var(--color-bg-surface-hover);
    color: inherit;
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .card-name {
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-white);
    overflow-wrap: anywhere;
  }

  .card-description {
    font-size: 0.875rem;
    color: var(--color-gray-2);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-action {
    display: flex;
    justify-content: space-between;
    padding-top: var(--space-lg);
    margin-top: auto;
    color: var(--color-gray-3);
    font-size: 0.75rem;
  }

  .reusable-card:hover .card-action {
    color: var(--color-accent-light);
  }
</style>
